eLabel":"约公元1780—1820年·版本待核"},{"id":"yuyouren","era":"民国","title":"于右任·草书满江红","script":"草书","place":"版本待核","museum":"请管理员指定馆藏与具体墨迹","status":"同词书写有不同作品","url":"","style":"zhang","size":340,"zoom":180,"glyph":"右","order":29,"milestone":"于右任以标准草书的主张回应现代书写传播，试图让草法更可识读。","portraitLabel":"于右任","year":1940,"dateLabel":"约公元1930—1950年·版本待核"},{"id":"qinling","era":"当代","title":"毛泽东·沁园春·雪","script":"草书","place":"手稿版本待核","museum":"请管理员指定所用手稿及收藏机构","status":"作品原词与题写手迹须区分","url":"","style":"zhang","size":360,"zoom":180,"glyph":"雪","order":30,"milestone":"毛泽东以大幅奔放草书连接诗词与现代公共记忆。","portraitLabel":"毛泽东","year":1957,"dateLabel":"约公元1950—1960年·手稿待核"}],"world":{"oracle":{"date":"约公元前1250年","title":"古埃及《阿尼亡灵书》","place":"英国·伦敦｜大英博物馆","url":"https://www.britishmuseum.org/collection/object/Y_EA10470-3","note":"纸草卷轴将文字、图像与信仰并置。"},"shigu":{"date":"公元前539年","title":"两河流域《居鲁士圆柱》","place":"英国·伦敦｜大英博物馆","url":"https://www.britishmuseum.org/collection/object/W_1880-0617-1941","note":"楔形文字记录巴比伦的政权更替。"},"mawangdui":{"date":"公元前196年","title":"古埃及《罗塞塔石碑》","place":"英国·伦敦｜大英博物馆","url":"https://www.britishmuseum.org/blog/everything-you-ever-wanted-know-about-rosetta-stone","note":"同一敕令由三种文字刻写。"},"juyan":{"date":"约公元前120—100年","title":"希伯来文《以赛亚书卷》","place":"以色列·耶路撒冷｜以色列博物馆","url":"https://dss.collections.imj.org.il/isaiah?id=17%3A11","note":"死海古卷保存长篇古代手稿。"},"zixu":{"date":"约公元800年","title":"爱尔兰《凯尔经》","place":"爱尔兰·都柏林｜圣三一学院","url":"https://www.tcd.ie/library/research-collections/book-of-kells.php","note":"拉丁文字与繁复装饰形成手抄本艺术。"},"tengwang":{"date":"约公元1455年","title":"欧洲《古腾堡圣经》","place":"英国·伦敦｜大英图书馆藏本","url":"https://www.bl.uk/collection/explore-the-collection","note":"金属活字印刷推动书籍传播。"},"jiuhua":{"date":"1000—1001年","title":"阿拉伯书法 · 伊本·巴瓦卜抄本","place":"爱尔兰·都柏林｜切斯特·比蒂图书馆","url":"https://chesterbeatty.ie/assets/uploads/2021/11/The-Unique-IBN-AL-BAWWAB-MANUSCRIPT.pdf","note":"承续伊本·穆格莱的比例书法，以点与几何比例组织字母，展现阿拉伯文字的韵律之美。"}},"slides":[{"id":"hello-world","n":"00","k":"亲笔 · 问好世界","title":"在世界的每个角落，\n写下你的问好。","sub":"山村、海岛、街巷与远方。\n无论你在哪里，亲笔都能让世界听见。","cta":"亲笔向世界问好","ink":"#314b3e","paper":"#f1ecdf","accent":"#a44d36","glyph":"世"},{"id":"civilization","n":"01","k":"文字 · 人类共同的长卷","title":"从世界各处，\n写向同一个人类。","sub":"甲骨、泥板、纸莎草与羊皮卷。\n不同文明留下不同笔迹，我们在这里相遇。","cta":"沿文明长卷漫游","ink":"#eae4cf","paper":"#273b42","accent":"#dbb47b","glyph":"文"},{"id":"handwriting","n":"02","k":"亲笔 · 穿越千年的共鸣","title":"一笔落下，\n千年后仍有人懂。","sub":"书写，是文明、思想与表达最直觉的印记。\n纸上留下的，是一个人曾经鲜活的心跳。","cta":"留下今天的亲笔","ink":"#42382e","paper":"#eee3cc","accent":"#a44d35","glyph":"心"},{"id":"constellation","n":"03","k":"手笔 · 文字方舟","title":"人类群星闪耀时","sub":"一起结网记字，打造文字方舟！","cta":"加入这一卷星光","ink":"#eee9da","paper":"#29352f","accent":"#d6b779","glyph":"星"},{"id":"single-scene","k":"手笔 · 大字反复练","title":"永字八法走起来，\n大字先拿下。","sub":"抹掉，再来一遍。\n等你驾驭好了大字，\n小字终于也可以……重新学了。","cta":"写一个大字","ink":"#263e35","paper":"#eee7d5","accent":"#a74732"},{"id":"nobel-scene","k":"手笔 · 诺奖句子亲笔摘抄","title":"写不出诺奖，\n还不能抄几句？","sub":"诺奖又要来了，先亲手摘抄几句。\n靠抄成为诺奖第一人？想得挺美。\n评委没空读？这事咱可不敢赌。","cta":"摘抄诺奖作品","ink":"#263e35","paper":"#eee7d5","accent":"#a74732"},{"id":"copy-scene","k":"手笔 · 喜欢的帖子统统临","title":"大神的帖子，\n这辈子统统临一遍。","sub":"踩着千年笔墨，一笔一划往前走。\n最后大神都会写了，\n自己怎么走？明天再研究。","cta":"去临喜欢的帖","ink":"#263e35","paper":"#eee7d5","accent":"#a74732"},{"id":"relay-scene","k":"手笔 · 亲友接力共书","title":"文字方舟都开工了，\n你怎么又去追剧？","sub":"孩子、家人、朋友、老外，一起接力。\n学汉字、成语接龙、手写留言。\n说好一起写，别只负责已读。","cta":"邀大家一起写","ink":"#263e35","paper":"#eee7d5","accent":"#a74732"},{"id":"reference","n":"01","k":"临帖浮窗","title":"古人的帖，\n就在你的笔边。","sub":"看原帖、翻组图、定位字格。\n浮窗相伴，让每一笔都有来处。","cta":"去临兰亭序","ink":"#243e38","paper":"#f0ead9","accent":"#c3603b","glyph":"永"},{"id":"passport","n":"02","k":"我的书法通关文牒","title":"二十帖。\n把千年，亲笔走一遍。","sub":"古人原帖在左，你的临写在右。\n一站一印，认真写过的今天都会留下。","cta":"展开我的文牒","ink":"#faf0d6","paper":"#283e36","accent":"#d9ae67","glyph":"牒"},{"id":"reader","n":"03","k":"文摘浮窗","title":"好文章，\n写一点就近一点。","sub":"全文就在笔边，边读边写。\n从前赤壁赋，写到你自己的江山。","cta":"亲笔写前赤壁赋","ink":"#3b414b","paper":"#e9edf0","accent":"#af533d","glyph":"赋"},{"id":"relay","n":"04","k":"接力共书","title":"同一卷纸。\n不同时光的相逢。","sub":"朋友接力题跋，各自钤印。\n今天落笔，明天有人接续。","cta":"发起一卷墨缘","ink":"#442e28","paper":"#f1e1ce","accent":"#b23326","glyph":"缘"},{"id":"expand","n":"05","k":"四向拓纸","title":"灵感还没写完？\n纸，跟你走。","sub":"预览三击显示拓纸箭头。\n点击或外拉加纸，向内收回。","cta":"试试四向拓纸","ink":"#e8e9df","paper":"#34464a","accent":"#d5a174","glyph":"展"},{"id":"heritage","n":"06","k":"印 · 墨 · 纸","title":"把世界的颜色，\n写进自己的字。","sub":"印墨纸三色，取意世界遗产。\n读一段设计理念，写一张远方来信。","cta":"遇见一组世界遗产配色","ink":"#294943","paper":"#e3e8d9","accent":"#b36041","glyph":"境"},{"id":"gestures","n":"07","k":"手势书写","title":"指尖一动。\n纸上有天地。","sub":"双击定位，三击拓纸，滑动换景。\n正文与题跋，也可以双指三击切换。","cta":"打开手势体验","ink":"#4b3847","paper":"#efe6ea","accent":"#a14b4b","glyph":"指"}],"canon":[{"id":"canon133-1","rank":1,"title":"兰亭集序","author":"王羲之","script":"行书","url":"https://digitalarchive.npm.gov.tw/Collection/Detail/1519?dep=P","writers":[{"name":"褚遂良","relation":"临写","url":"https://www.npm.gov.tw/News-Content.aspx?idstr=MDMwMDAwOTY%3D&l=1&sno=04014432"},{"name":"赵孟頫","relation":"临写","url":"https://www.npm.gov.tw/News-Content.aspx?idstr=MDMwMDAwOTY%3D&l=1&sno=04014432"},{"name":"董其昌","relation":"临写","url":"https://www.npm.gov.tw/News-Content.aspx?idstr=MDMwMDAwOTY%3D&l=1&sno=04014432"},{"name":"文徵明","relation":"临写","url":"https://www.npm.gov.tw/News-Content.aspx?idstr=MDMwMDAwOTY%3D&l=1&sno=04014432"}]},{"id":"canon133-2","rank":2,"title":"祭侄文稿","author":"颜真卿","script":"行书","url":"https://theme.npm.edu.tw/selection/Article.aspx?sNo=04001003","writers":[]},{"id":"canon133-3","rank":3,"title":"黄州寒食帖","author":"苏轼","script":"行书","url":"https://digitalarchive.npm.gov.tw/Collection/Detail/23018?dep=P","writers":[]},{"id":"canon133-4","rank":4,"title":"石鼓文","author":"佚名","script":"篆书","url":"https://www.dpm.org.cn/collection/impres/234438.html","writers":[{"name":"吴昌硕","relation":"临写石鼓文","url":"https://digitalarchive.npm.gov.tw/Collection/Detail/30826?dep=P"}]},{"id":"canon133-5","rank":5,"title":"九成宫醴泉铭","author":"欧阳询","script":"楷书","url":"http